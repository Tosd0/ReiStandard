{
  "functions": {
    "api/test-active-messaging.js": {
      "maxDuration": 300
    }
  },

  "headers": [
    {
      "source": "/api/test-active-messaging",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
